# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 运行数据与密钥（ meetings.json / enc_key 主密钥 / 备份 )
/.data/
/data/

# AI 工作台内部笔记（任务记录、长期备忘，不入公开版本库）
/.workbuddy/

# 本地验证产物（截图与 CDP 脚本）
/screenshots/

# 测试运行日志
scripts/*.log

# 测试日志（含子目录）
scripts/**/*.log

# IDE 配置
/.idea/
